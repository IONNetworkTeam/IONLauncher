<%#
    The title bar (36px, --frame-h): the window's drag handle, the launcher's navigation (titlebar.js),
    the coin balance reported by the website (shell.js), settings, the account and the window controls.
    Ids read by other scripts: frameCoins, frameCoinsValue, settingsMediaButton, image_seal_container,
    updateDot, avatarOverlay, avatarContainer, user_text.
%>
<%
    const tabs = ['home', 'challenges', 'stats', 'news']
    const winButton = 'winbtn frameButton'
%>
<div id="frameBar" class="tb app-drag select-none">
    <span class="horizon"></span>
    <%if (process.platform === 'darwin') { %>
        <div id="frameButtonDockDarwin" class="app-no-drag flex items-center gap-2 pl-3 pr-2">
            <button class="fCb h-3 w-3 rounded-full !bg-[#ff5f57] hover:brightness-110" id="frameButtonDarwin_close" tabIndex="-1" aria-label="<%= lang('frame.close') %>"></button>
            <button class="fMb h-3 w-3 rounded-full !bg-[#febc2e] hover:brightness-110" id="frameButtonDarwin_minimize" tabIndex="-1" aria-label="<%= lang('frame.minimize') %>"></button>
            <button class="fRb h-3 w-3 rounded-full !bg-[#28c840] hover:brightness-110" id="frameButtonDarwin_restoredown" tabIndex="-1" aria-label="<%= lang('frame.maximize') %>"></button>
        </div>
    <% } %>
    <div id="frameTitleDock" class="tb-brand">
        <img src="assets/images/ion/star.svg" alt="">
        <span id="frameTitleText"><%= lang('app.title') %></span>
    </div>
    <nav id="ionNav" class="mb app-no-drag" aria-label="<%= lang('frame.navLabel') %>">
        <span id="ionNavLit" class="mb-lit"></span>
        <% tabs.forEach(tab => { %>
            <div class="mb-cell">
                <button class="mb-item" data-tab="<%= tab %>"<%- tab === 'home' ? ' aria-current="page"' : '' %>>
                    <span><%= lang('frame.tab.' + tab) %></span>
                    <span class="mono mb-badge" hidden></span>
                </button>
                <% if (tab !== 'home') { %>
                    <button class="peek" data-peek="<%= tab %>" data-ready="false" tabindex="-1" aria-hidden="true">
                        <img class="peek-img" alt="">
                        <span class="mono peek-kicker"></span>
                        <span class="peek-title"></span>
                        <span class="peek-foot"><span class="mono peek-meta"></span><span class="peek-cta"><%= lang('frame.peekOpen') %></span></span>
                    </button>
                <% } %>
            </div>
        <% }) %>
    </nav>
    <div class="tb-drag"></div>
    <a id="frameCoins" href="#" data-tab-link="challenges" title="<%= lang('frame.coinsTitle') %>" class="tb-coins app-no-drag hidden">
        <img src="assets/images/ion/coin.svg" alt="">
        <span id="frameCoinsValue">0</span>
    </a>
    <div id="image_seal_container" class="tb-gear-wrap app-no-drag">
        <button id="settingsMediaButton" class="tb-icon" aria-label="<%= lang('landing.settingsTooltip') %>" aria-pressed="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M10.3 3.6a1.7 1.7 0 0 1 3.4 0l.2 1a1.7 1.7 0 0 0 2.5 1l.9-.5a1.7 1.7 0 0 1 2.4 2.4l-.5.9a1.7 1.7 0 0 0 1 2.5l1 .2a1.7 1.7 0 0 1 0 3.4l-1 .2a1.7 1.7 0 0 0-1 2.5l.5.9a1.7 1.7 0 0 1-2.4 2.4l-.9-.5a1.7 1.7 0 0 0-2.5 1l-.2 1a1.7 1.7 0 0 1-3.4 0l-.2-1a1.7 1.7 0 0 0-2.5-1l-.9.5a1.7 1.7 0 0 1-2.4-2.4l.5-.9a1.7 1.7 0 0 0-1-2.5l-1-.2a1.7 1.7 0 0 1 0-3.4l1-.2a1.7 1.7 0 0 0 1-2.5l-.5-.9a1.7 1.7 0 0 1 2.4-2.4l.9.5a1.7 1.7 0 0 0 2.5-1z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
        <span id="updateDot" class="tb-dot hidden" title="<%- lang('landing.updateAvailableTooltip') %>"></span>
    </div>
    <button id="avatarOverlay" class="acct app-no-drag" aria-haspopup="menu" aria-expanded="false" aria-label="<%= lang('landing.accountButton') %>">
        <span id="avatarContainer" class="head"></span>
        <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="color: rgba(255,255,255,.5)"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <%if (process.platform !== 'darwin') { %>
        <span class="tb-sep"></span>
        <div id="frameButtonDockWin" class="app-no-drag flex h-full">
            <button class="<%= winButton %> fMb" id="frameButton_minimize" tabIndex="-1" aria-label="<%= lang('frame.minimize') %>">
                <svg width="10" height="10" viewBox="0 0 12 12"><rect fill="currentColor" width="10" height="1" x="1" y="6"></rect></svg>
            </button>
            <button class="<%= winButton %> fRb" id="frameButton_restoredown" tabIndex="-1" aria-label="<%= lang('frame.maximize') %>">
                <svg width="10" height="10" viewBox="0 0 12 12"><rect width="9" height="9" x="1.5" y="1.5" fill="none" stroke="currentColor" stroke-width="1.2"></rect></svg>
            </button>
            <button class="<%= winButton %> fCb x" id="frameButton_close" tabIndex="-1" aria-label="<%= lang('frame.close') %>">
                <svg width="10" height="10" viewBox="0 0 12 12"><polygon fill="currentColor" fill-rule="evenodd" points="11 1.576 6.583 6 11 10.424 10.424 11 6 6.583 1.576 11 1 10.424 5.417 6 1 1.576 1.576 1 6 5.417 10.424 1"></polygon></svg>
            </button>
        </div>
    <% } %>
</div>
<div id="accountMenu" class="am" role="menu" aria-hidden="true">
    <div class="am-me">
        <img class="head am-me-head" alt="">
        <span><span class="am-me-name"></span><span class="mono am-me-sub"><%= lang('frame.signedIn') %></span></span>
    </div>
    <div class="am-rule"></div>
    <div class="am-others"></div>
    <button class="am-item" role="menuitem" data-manage><span class="am-plus">+</span><%= lang('frame.addAccount') %></button>
    <div class="am-rule"></div>
    <button class="am-item" role="menuitem" data-manage><%= lang('frame.manageAccounts') %></button>
</div>
