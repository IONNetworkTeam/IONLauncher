<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/ion-theme.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/ion.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/slices.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/workspace.css">
    <style>
        body {
            background: #07080b;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            height: calc(100% - var(--frame-h));
            background: radial-gradient(90% 65% at 12% 0%, rgba(119, 119, 223, 0.22), transparent 70%), #1E212B;
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body bkid="<%=bkid%>">
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <img id="loadCenterImage" src="assets/images/ion/star.svg" alt="">
                <img id="loadSpinnerImage" class="rotating" src="assets/images/ion/ring.svg" alt="">
            </div>
        </div>
    </div>
</body>
</html>