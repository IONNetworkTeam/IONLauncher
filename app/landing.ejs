    const star = 'M6.08 0.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M5.08 1.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M6.08 1.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M7.08 1.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M4.08 2.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M5.08 2.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M6.08 2.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M7.08 2.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M8.08 2.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M4.08 3.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M5.08 3.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M6.08 3.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M7.08 3.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M8.08 3.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M2.08 4.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M3.08 4.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M4.08 4.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M5.08 4.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M6.08 4.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M7.08 4.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M8.08 4.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M9.08 4.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M10.08 4.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M1.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M2.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M3.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M4.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M5.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M6.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M7.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M8.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M9.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M10.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M11.08 5.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M0.08 6.5a0.42 0.42 0 1 0 0.84 0a0.42 0.42 0 1 0 -0.84 0M1.08 6.5a0.42 0.42