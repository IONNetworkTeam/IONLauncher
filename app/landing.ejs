<%#
    The Play view (slices.js): the releases on the shelf as full-height slices of their wallpapers,
    the library strip, the library, the website tabs and the live map (shell.js), and the launch
    cluster that slices.js moves into the open slice.

    landing.js relies on: launch_button, launch_details_text. shell.js on: [data-tab-panel],
    ionToasts. The title bar (frame.ejs) holds the navigation and the account.
%>
<div id="landingContainer" class="ion-shell" style="display: none;">
    <div id="stage" class="stage" aria-label="<%= lang('slices.stageLabel') %>">
        <button id="libStrip" class="lib-strip" aria-label="<%= lang('slices.allReleases') %>">
            <span id="libMosaic" class="lib-mosaic"></span>
            <span class="lib-label">
                <span class="mono lib-total"></span>
                <span class="lib-label-mid">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/></svg>
                    <span class="tag-name lib-label-text"><%= lang('slices.allReleases') %></span>
                </span>
            </span>
        </button>
    </div>

    <section id="library" class="lib" aria-hidden="true">
        <div class="flex h-full flex-col">
            <header class="lib-head">
                <span><span class="lib-title"><%= lang('library.title') %></span><span class="mono lib-count"></span></span>
                <label class="search lib-search">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color: rgba(255,255,255,.5)"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
                    <input type="text" placeholder="<%= lang('library.search') %>" aria-label="<%= lang('library.search') %>">
                </label>
                <div class="flex gap-1">
                    <button class="chip" data-filter="all" aria-pressed="true"><%= lang('library.filterAll') %></button>
                    <button class="chip" data-filter="gameserver" aria-pressed="false"><%= lang('library.filterGameServers') %></button>
                    <button class="chip" data-filter="modpack" aria-pressed="false"><%= lang('library.filterModpacks') %></button>
                </div>
                <div class="flex-1"></div>
                <button class="chip" data-close aria-pressed="false"><%= lang('library.close') %></button>
            </header>
            <div class="lib-body"></div>
        </div>
    </section>

    <section class="web" data-tab-panel="challenges" data-tab-hidden data-web-path="/challenges"></section>
    <section class="web" data-tab-panel="stats" data-tab-hidden data-web-path="/stats"></section>
    <section class="web" data-tab-panel="news" data-tab-hidden data-web-path="/blog"></section>
    <section class="web" data-tab-panel="map" data-tab-hidden data-web-path=""></section>

    <div id="launchCluster" class="launch">
        <div class="launch-cap"><span id="launch_caption" class="mono"></span><span id="launch_side" class="mono"></span></div>
        <button id="launch_button" class="play">
            <span class="play-fill"></span>
            <span class="play-sheen"></span>
            <svg class="launch-star" viewBox="0 0 13 13" aria-hidden="true"><path class="dots-dim" fill="currentColor" opacity=".22"/><path class="dots-lit" fill="currentColor"/></svg>
            <span class="play-text"><span class="launch-label is-word"></span><span id="launch_details_text" class="mono"></span></span>
        </button>
    </div>

    <div id="ionToasts" aria-live="polite" class="pointer-events-none absolute bottom-6 right-6 z-50 flex flex-col items-end gap-2"></div>

    <script src="./assets/js/scripts/landing.js"></script>
    <script src="./assets/js/scripts/modsetup.js"></script>
    <script src="./assets/js/scripts/shell.js"></script>
    <script src="./assets/js/scripts/slices.js"></script>
    <script src="./assets/js/scripts/library.js"></script>
    <script src="./assets/js/scripts/panels.js"></script>
    <script src="./assets/js/scripts/titlebar.js"></script>
    <script src="./assets/js/scripts/workspace.js"></script>
</div>
