<%#
    The ION account step after the Minecraft sign-in (ionaccount.js). One form in four modes, set as
    data-mode on the container: register (the default), login, twofa, and done. Elements carrying
    data-show list the modes they appear in.
%>
<div id="ionAccountContainer" class="ob-view" data-mode="register" style="display: none;">
    <form id="ionAccountForm" class="ob-body" autocomplete="off" novalidate>
        <img class="ob-mark" src="assets/images/ion/star.svg" alt="">
        <h1 class="ob-title">
            <span data-show="register"><%- lang('ionAccount.registerTitle') %></span>
            <span data-show="login"><%- lang('ionAccount.loginTitle') %></span>
            <span data-show="twofa"><%- lang('ionAccount.twofaTitle') %></span>
            <span data-show="done" id="ionAccountDoneTitle"></span>
        </h1>
        <p class="ob-lede">
            <span data-show="register"><%- lang('ionAccount.registerDescription') %></span>
            <span data-show="login"><%- lang('ionAccount.loginDescription') %></span>
            <span data-show="twofa"><%- lang('ionAccount.twofaDescription') %></span>
            <span data-show="done" id="ionAccountDoneText"></span>
        </p>

        <div class="ob-player" data-show="register">
            <img id="ionAccountHead" class="ob-player-head" alt="">
            <span class="ob-option-text">
                <span id="ionAccountName" class="ob-option-name"></span>
                <span class="ob-option-sub"><%- lang('ionAccount.nameNote') %></span>
            </span>
        </div>

        <p id="ionAccountError" class="ob-alert" role="alert" hidden></p>

        <div class="ob-fields" data-show="register login twofa">
            <label class="ob-field" data-show="register">
                <span class="ob-field-head"><span><%- lang('ionAccount.email') %></span></span>
                <input id="ionAccountEmail" class="ob-input" type="email" spellcheck="false" autocomplete="email"/>
            </label>
            <label class="ob-field" data-show="login">
                <span class="ob-field-head"><span><%- lang('ionAccount.identifier') %></span></span>
                <input id="ionAccountIdentifier" class="ob-input" type="text" spellcheck="false" autocomplete="username"/>
            </label>
            <label class="ob-field" data-show="register login">
                <span class="ob-field-head">
                    <span><%- lang('ionAccount.password') %></span>
                    <button type="button" id="ionAccountReveal" class="ob-reveal"><%- lang('ionAccount.show') %></button>
                </span>
                <input id="ionAccountPassword" class="ob-input" type="password" autocomplete="current-password"/>
                            </label>
            <label class="ob-field" data-show="twofa">
                <span class="ob-field-head"><span><%- lang('ionAccount.code') %></span></span>
                <input id="ionAccountCode" class="ob-input ob-input-code" type="text" inputmode="numeric" maxlength="7" autocomplete="one-time-code"/>
            </label>
        </div>

        <label class="ob-check ob-consent" data-show="register">
            <input id="ionAccountConsent" type="checkbox">
            <span class="ob-check-box" aria-hidden="true"></span>
            <span><%- lang('ionAccount.consent', { privacy: `<a class="ob-link" id="ionAccountPrivacy" href="#">${lang('ionAccount.privacy')}</a>` }) %></span>
        </label>
        <div class="ob-row" data-show="login">
            <span></span>
            <a class="ob-link" id="ionAccountForgot" href="#"><%- lang('ionAccount.forgot') %></a>
        </div>

        <button id="ionAccountSubmit" type="submit" class="ob-primary ob-primary-wide">
            <span data-show="register"><%- lang('ionAccount.register') %></span>
            <span data-show="login"><%- lang('ionAccount.login') %></span>
            <span data-show="twofa"><%- lang('ionAccount.verify') %></span>
            <span data-show="done"><%- lang('ionAccount.play') %></span>
            <svg class="ob-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            <span class="ob-spinner" aria-hidden="true"></span>
        </button>

        <button type="button" id="ionAccountDiscord" class="ob-discord" data-show="register login">
            <svg viewBox="0 0 127.14 96.36" aria-hidden="true"><path fill="currentColor" d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69Z"/></svg>
            <span><%- lang('ionAccount.discord') %></span>
            <span class="ob-spinner" aria-hidden="true"></span>
        </button>
        <p class="ob-switch" data-show="register"><%- lang('ionAccount.haveAccount') %> <button type="button" class="ob-switch-btn" data-mode-to="login"><%- lang('ionAccount.toLogin') %></button></p>
        <p class="ob-switch" data-show="twofa"><button type="button" class="ob-switch-btn" data-mode-to="login"><%- lang('ionAccount.backToLogin') %></button></p>
        <p class="ob-switch" data-show="login"><%- lang('ionAccount.newHere') %> <button type="button" class="ob-switch-btn" data-mode-to="register"><%- lang('ionAccount.toRegister') %></button></p>
        <button type="button" id="ionAccountSkip" class="ob-skip" data-show="register login twofa"><%- lang('ionAccount.skip') %></button>
    </form>
    <script src="./assets/js/scripts/ionaccount.js"></script>
</div>
