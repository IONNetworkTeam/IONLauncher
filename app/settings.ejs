<%#
    Settings, as a workspace beside the folded release band (workspace.js, workspace.css): a section
    bar, then one column of sections — a ruled heading (.gh) and rows (.row: title and description
    on the left, the control on the right).

    settings.js binds this markup by id and by [cValue]; keep both. It also relies on three
    sibling orders: a .settingsFileSelButton directly follows its input, a .settingsSelectOptions
    directly follows its .settingsSelectSelected, and a .rangeSlider holds .rangeSliderBar and
    .rangeSliderTrack.
%>
<div id="settingsContainer" style="display: none;">
    <div id="settingsContainerLeft">
        <div id="settingsNavContainer">
            <div id="settingsNavHeader">
                <span id="settingsNavHeaderText"><%- lang('settings.navHeaderText') %></span>
            </div>
            <div id="settingsNavItemsContainer">
                <div id="settingsNavItemsContent">
                    <button class="settingsNavItem" rSc="settingsTabMinecraft"><%- lang('settings.navMinecraft') %></button>
                    <button class="settingsNavItem" rSc="settingsTabJava"><%- lang('settings.navJava') %></button>
                    <button class="settingsNavItem" rSc="settingsTabMods"><%- lang('settings.navMods') %></button>
                    <button class="settingsNavItem" rSc="settingsTabLauncher"><%- lang('settings.navLauncher') %></button>
                    <button class="settingsNavItem" rSc="settingsTabAccount" id="settingsNavAccount" selected><%- lang('settings.navAccount') %></button>
                    <div class="settingsNavSpacer"></div>
                    <button class="settingsNavItem" rSc="settingsTabAbout"><%- lang('settings.navAbout') %></button>
                    <button class="settingsNavItem" rSc="settingsTabUpdate" id="settingsNavUpdate"><%- lang('settings.navUpdates') %></button>
                    <div id="settingsNavContentBottom">
                        <button id="settingsNavDone"><%- lang('settings.navDone') %> <span class="kbd">ESC</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="settingsContainerRight">

        <%# ---- Minecraft ---- %>
        <div id="settingsTabMinecraft" class="settingsTab" style="display: none;">
            <div class="gh"><h3><%- lang('settings.sectionWindow') %></h3><i></i></div>
            <div class="row">
                <div><div class="rt"><%- lang('settings.gameResolutionTitle') %></div><div class="rd"><%- lang('settings.gameResolutionDesc') %></div></div>
                <div class="ws-res">
                    <input type="number" id="settingsGameWidth" class="field" min="0" cValue="GameWidth" aria-label="Width">
                    <span class="ws-res-x">×</span>
                    <input type="number" id="settingsGameHeight" class="field" min="0" cValue="GameHeight" aria-label="Height">
                </div>
            </div>
            <div class="row">
                <div><div class="rt"><%- lang('settings.launchFullscreenTitle') %></div></div>
                <label class="toggleSwitch"><input type="checkbox" cValue="Fullscreen"><span class="toggleSwitchSlider"></span></label>
            </div>

            <div class="gh"><h3><%- lang('settings.sectionLaunch') %></h3><i></i></div>
            <div class="row">
                <div><div class="rt"><%- lang('settings.autoConnectTitle') %></div></div>
                <label class="toggleSwitch"><input type="checkbox" cValue="AutoConnect"><span class="toggleSwitchSlider"></span></label>
            </div>
            <div class="row">
                <div><div class="rt"><%- lang('settings.launchDetachedTitle') %></div><div class="rd"><%- lang('settings.launchDetachedDesc') %></div></div>
                <label class="toggleSwitch"><input type="checkbox" cValue="LaunchDetached"><span class="toggleSwitchSlider"></span></label>
            </div>

            <div class="gh"><h3><%- lang('settings.sectionSync') %></h3><i></i></div>
            <div class="row">
                <div><div class="rt"><%- lang('settings.settingsSyncTitle') %></div><div class="rd"><%- lang('settings.settingsSyncDesc') %></div></div>
                <label class="toggleSwitch"><input type="checkbox" id="settingsSyncEnabled" cValue="SettingsSyncEnabled"><span class="toggleSwitchSlider"></span></label>
            </div>
            <div id="settingsSyncServersContainer">
                <div class="ws-sub"><div class="rt"><%- lang('settings.settingsSyncServersHeader') %></div><div class="rd" id="settingsSyncServersDesc"><%- lang('settings.settingsSyncServersDesc') %></div></div>
                <div id="settingsSyncServersContent"></div>
                <div class="row settingsSyncPacksField">
                    <div><div class="rt"><%- lang('settings.sharePacksTitle') %></div><div class="rd"><%- lang('settings.sharePacksDesc') %></div></div>
                    <label class="toggleSwitch"><input type="checkbox" id="settingsSharePacks" cValue="SharePacks"><span class="toggleSwitchSlider"></span></label>
                </div>
                <div id="settingsSyncPacksContainer">
                    <div class="ws-sub"><div class="rt"><%- lang('settings.sharedPacksHeader') %></div><div class="rd" id="settingsSyncPacksDesc"><%- lang('settings.sharedPacksDesc') %></div></div>
                    <div id="settingsSyncPacksContent"></div>
                </div>
            </div>
        </div>

        <%# ---- Java ---- %>
        <div id="settingsTabJava" class="settingsTab" style="display: none;">
            <p class="ws-applies"><span><%- lang('settings.appliesTo') %></span><i></i><b class="ws-applies-name"></b></p>
            <p class="ws-applies-note"><%- lang('settings.appliesToNote') %></p>
            <div class="settingsSelServContainer">
                <div class="settingsSelServContent"></div>
                <div class="settingsSwitchServerContainer"><div class="settingsSwitchServerContent"><button class="settingsSwitchServerButton"><%- lang('settings.switchServerButton') %></button></div></div>
            </div>

            <div class="gh"><h3><%- lang('settings.memoryTitle') %></h3><i></i></div>
            <div class="ws-mem">
                <div class="ws-mem-top">
                    <span id="settingsMaxRAMLabel" class="settingsMemoryLabel ws-mem-big">3G</span>
                    <div class="ws-mem-side">
                        <span><%- lang('settings.maxRAM') %> · <b class="ws-applies-name"></b></span>
                        <span><%- lang('settings.memoryTotalTitle') %> <b id="settingsMemoryTotal" class="settingsMemoryStatusValue">16G</b> · <%- lang('settings.memoryAvailableTitle') %> <b id="settingsMemoryAvail" class="settingsMemoryStatusValue">7.3G</b></span>
                    </div>
                </div>
                <div id="settingsMaxRAMRange" class="rangeSlider" cValue="MaxRAM" serverDependent min="3" max="8" value="3" step="0.5">
                    <div class="rangeSliderBar"></div>
                    <div class="rangeSliderTrack"></div>
                </div>
            </div>
            <div class="row">
                <div><div class="rt"><%- lang('settings.minRAM') %></div><div class="rd"><%- lang('settings.memoryDesc') %></div></div>
                <div class="ws-min">
                    <div id="settingsMinRAMRange" class="rangeSlider" cValue="MinRAM" serverDependent min="3" max="8" value="3" step="0.5">
                        <div class="rangeSliderBar"></div>
                        <div class="rangeSliderTrack"></div>
                    </div>
                    <span id="settingsMinRAMLabel" class="settingsMemoryLabel">3G</span>
                </div>
            </div>

            <div class="gh"><h3><%- lang('settings.javaExecutableTitle') %></h3><i></i></div>
            <div class="ws-block">
                <div class="rt" id="settingsJavaExecDetails"><!-- Invalid Selection --></div>
                <div class="ws-file">
                    <input class="settingsFileSelVal field" id="settingsJavaExecVal" type="text" value="null" cValue="JavaExecutable" serverDependent disabled>
                    <button class="settingsFileSelButton btn" id="settingsJavaExecSel" dialogTitle="<%- lang('settings.javaExecSelDialogTitle') %>" dialogDirectory="false"><%- lang('settings.javaExecSelButtonText') %></button>
                </div>
                <div class="rd"><%- lang('settings.javaExecDesc') %> <strong id="settingsJavaReqDesc"><!-- Requires Java 8 x64. --></strong><br><%- lang('settings.javaPathDesc', {'pathSuffix': `bin${process.platform === 'win32' ? '\\javaw.exe' : '/java'}`}) %></div>
            </div>

            <div class="gh"><h3><%- lang('settings.jvmOptsTitle') %></h3><i></i></div>
            <div class="ws-block">
                <input id="settingsJVMOptsVal" class="field ws-wide" cValue="JVMOptions" serverDependent type="text" aria-label="<%- lang('settings.jvmOptsTitle') %>">
                <div class="rd"><%- lang('settings.jvmOptsDesc') %> <a href="#" id="settingsJvmOptsLink"><!-- Available Options --></a></div>
            </div>
        </div>

        <%# ---- Mods ---- %>
        <div id="settingsTabMods" class="settingsTab" style="display: none;">
            <p class="ws-applies"><span><%- lang('settings.appliesTo') %></span><i></i><b class="ws-applies-name"></b></p>
            <p class="ws-applies-note"><%- lang('settings.appliesToNote') %></p>
            <div class="settingsSelServContainer">
                <div class="settingsSelServContent"></div>
                <div class="settingsSwitchServerContainer"><div class="settingsSwitchServerContent"><button class="settingsSwitchServerButton"><%- lang('settings.switchServerButton') %></button></div></div>
            </div>
            <div id="settingsModsContainer">
                <div class="gh"><h3><%- lang('settings.optionalMods') %></h3><i></i></div>
                <div id="settingsOptModsContent"></div>

                <div class="gh"><h3><%- lang('settings.dropinMods') %></h3><i></i></div>
                <div class="row">
                    <div><div class="rt"><%- lang('settings.dropinModsTitle') %></div><div class="rd"><%- lang('settings.dropinModsDesc') %></div></div>
                    <button id="settingsDropinFileSystemButton" class="btn"><%- lang('settings.addMods') %></button>
                </div>
                <div id="settingsDropinModsContent"></div>

                <div class="gh"><h3><%- lang('settings.shaderpacks') %></h3><i></i></div>
                <div class="row">
                    <div><div class="rt"><%- lang('settings.shaderpackTitle') %></div><div class="rd"><%- lang('settings.shaderpackDesc') %></div></div>
                    <div class="ws-shader">
                        <div class="settingsSelectContainer">
                            <div class="settingsSelectSelected field" id="settingsShadersSelected"><%- lang('settings.selectShaderpack') %></div>
                            <div class="settingsSelectOptions" id="settingsShadersOptions" hidden></div>
                        </div>
                        <button id="settingsShaderpackButton" class="btn" title="<%- lang('settings.shaderpackFolder') %>" aria-label="<%- lang('settings.shaderpackFolder') %>">+</button>
                    </div>
                </div>

                <div class="gh"><h3><%- lang('settings.requiredMods') %></h3><i></i></div>
                <div id="settingsReqModsContent"></div>
            </div>
        </div>

        <%# ---- Launcher ---- %>
        <div id="settingsTabLauncher" class="settingsTab" style="display: none;">
            <div class="gh"><h3><%- lang('settings.sectionChannel') %></h3><i></i></div>
            <div class="row">
                <div><div class="rt"><%- lang('settings.allowPrereleaseTitle') %></div><div class="rd"><%- lang('settings.allowPrereleaseDesc') %></div></div>
                <label class="toggleSwitch"><input type="checkbox" cValue="AllowPrerelease"><span class="toggleSwitchSlider"></span></label>
            </div>

            <div class="gh"><h3><%- lang('settings.sectionStorage') %></h3><i></i></div>
            <div class="ws-block">
                <div class="rt"><%- lang('settings.dataDirectoryTitle') %></div>
                <div class="ws-file">
                    <input class="settingsFileSelVal field" type="text" value="null" cValue="DataDirectory" disabled aria-label="<%- lang('settings.dataDirectoryTitle') %>">
                    <button class="settingsFileSelButton btn" dialogTitle="<%- lang('settings.selectDataDirectory') %>" dialogDirectory="true"><%- lang('settings.chooseFolder') %></button>
                </div>
                <div class="rd"><%- lang('settings.dataDirectoryDesc') %></div>
            </div>
        </div>

        <%# ---- Account ---- %>
        <div id="settingsTabAccount" class="settingsTab">
            <div class="gh"><h3><%- lang('settings.microsoftAccount') %></h3><i></i><button class="settingsAddAuthAccount btn" id="settingsAddMicrosoftAccount"><%- lang('settings.addMicrosoftAccount') %></button></div>
            <div class="settingsCurrentAccounts" id="settingsCurrentMicrosoftAccounts">
                <!-- Microsoft auth accounts populated here. -->
            </div>

            <div class="gh"><h3><%- lang('settings.mojangAccount') %></h3><i></i><button class="settingsAddAuthAccount btn" id="settingsAddMojangAccount"><%- lang('settings.addMojangAccount') %></button></div>
            <div class="settingsCurrentAccounts" id="settingsCurrentMojangAccounts">
                <!-- Mojang auth accounts populated here. -->
            </div>
        </div>

        <%# ---- About ---- %>
        <div id="settingsTabAbout" class="settingsTab" style="display: none;">
            <div class="gh"><h3><%- lang('settings.sectionVersion') %></h3><i></i></div>
            <div class="ws-version">
                <div>
                    <div class="ws-version-title"><span id="settingsAboutCurrentVersionCheck">&#10003;</span> <span id="settingsAboutCurrentVersionTitle"><%- lang('settings.stableRelease') %></span></div>
                    <div class="ws-version-big" id="settingsAboutCurrentVersionValue">0.0.1-alpha.18</div>
                    <div class="rd"><%- lang('settings.aboutTitle', { appName: lang('app.title') }) %></div>
                </div>
            </div>
            <div class="ws-links">
                <a href="<%- lang('settings.sourceGithubLink') %>" class="settingsAboutButton btn"><%- lang('settings.sourceGithub') %></a>
                <%# The following must be included in third-party usage. %>
                <a href="https://github.com/dscalzi/HeliosLauncher" class="settingsAboutButton btn">Original Source</a>
                <a href="<%- lang('settings.supportLink') %>" class="settingsAboutButton btn"><%- lang('settings.support') %></a>
                <a href="#" id="settingsAboutDevToolsButton" class="settingsAboutButton btn"><%- lang('settings.devToolsConsole') %></a>
            </div>
            <div class="settingsChangelogContainer">
                <div class="gh"><h3><%- lang('settings.releaseNotes') %></h3><i></i></div>
                <div class="settingsChangelogContent">
                    <div class="settingsChangelogTitle rt"><%- lang('settings.changelog') %></div>
                    <div class="settingsChangelogText"><%- lang('settings.noReleaseNotes') %></div>
                </div>
                <div class="settingsChangelogActions">
                    <a class="settingsChangelogButton settingsAboutButton btn" href="#"><%- lang('settings.viewReleaseNotes') %></a>
                </div>
            </div>
        </div>

        <%# ---- Updates ---- %>
        <div id="settingsTabUpdate" class="settingsTab" style="display: none;">
            <div class="gh"><h3><%- lang('settings.sectionVersion') %></h3><i></i></div>
            <div class="ws-version">
                <div>
                    <div class="ws-version-title"><span id="settingsUpdateVersionCheck">&#10003;</span> <span id="settingsUpdateVersionTitle"><%- lang('settings.stableRelease') %></span></div>
                    <div class="ws-version-big" id="settingsUpdateVersionValue">0.0.1-alpha.18</div>
                    <div class="rd" id="settingsUpdateTitle"><!-- You Are Running the Latest Version --></div>
                </div>
                <button id="settingsUpdateActionButton" class="btn"><%- lang('settings.checkForUpdates') %></button>
            </div>
            <div class="settingsChangelogContainer">
                <div class="gh"><h3><%- lang('settings.releaseNotes') %></h3><i></i></div>
                <div class="settingsChangelogContent">
                    <div class="settingsChangelogTitle rt"><%- lang('settings.changelog') %></div>
                    <div class="settingsChangelogText"><%- lang('settings.noReleaseNotes') %></div>
                </div>
                <div class="settingsChangelogActions">
                    <a class="settingsChangelogButton settingsAboutButton btn" href="#"><%- lang('settings.viewReleaseNotes') %></a>
                </div>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/settings.js"></script>
</div>
