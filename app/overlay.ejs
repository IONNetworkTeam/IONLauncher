<div id="overlayContainer" class="dlg" hidden>
    <div id="serverSelectContent" class="dlg-card is-wide" role="dialog" aria-modal="true" aria-labelledby="serverSelectHeader" style="display: none;">
        <div class="dlg-head">
            <span class="dlg-icon" data-dialog-icon="server"></span>
            <span class="dlg-kicker"><%- lang('overlay.serverSelectKicker') %></span>
        </div>
        <h2 id="serverSelectHeader" class="dlg-title"><%- lang('overlay.serverSelectHeader') %></h2>
        <div id="serverSelectListScrollable" class="dlg-list">
            <!-- Server listings populated here. -->
        </div>
        <div id="serverSelectActions" class="dlg-actions">
            <button id="serverSelectCancel" class="dlg-btn dlg-ghost overlayKeybindEsc"><%- lang('overlay.serverSelectCancel') %></button>
            <button id="serverSelectConfirm" class="dlg-btn dlg-primary overlayKeybindEnter" type="submit"><%- lang('overlay.serverSelectConfirm') %></button>
        </div>
    </div>
    <div id="accountSelectContent" class="dlg-card" role="dialog" aria-modal="true" aria-labelledby="accountSelectHeader" style="display: none;">
        <div class="dlg-head">
            <span class="dlg-icon" data-dialog-icon="account"></span>
            <span class="dlg-kicker"><%- lang('overlay.accountSelectKicker') %></span>
        </div>
        <h2 id="accountSelectHeader" class="dlg-title"><%- lang('overlay.accountSelectHeader') %></h2>
        <div id="accountSelectListScrollable" class="dlg-list">
            <!-- Accounts populated here. -->
        </div>
        <div id="accountSelectActions" class="dlg-actions">
            <button id="accountSelectCancel" class="dlg-btn dlg-ghost overlayKeybindEsc"><%- lang('overlay.accountSelectCancel') %></button>
            <button id="accountSelectConfirm" class="dlg-btn dlg-primary overlayKeybindEnter" type="submit"><%- lang('overlay.accountSelectConfirm') %></button>
        </div>
    </div>
    <div id="overlayContent" class="dlg-card" role="alertdialog" aria-modal="true" aria-labelledby="overlayTitle" aria-describedby="overlayDesc">
        <div class="dlg-head">
            <span id="overlayIcon" class="dlg-icon"></span>
            <span id="overlayKicker" class="dlg-kicker"></span>
        </div>
        <h2 id="overlayTitle" class="dlg-title"></h2>
        <p id="overlayDesc" class="dlg-body"></p>
        <div id="overlayActionContainer" class="dlg-actions">
            <button id="overlayDismiss" style="display: none;" class="dlg-btn dlg-ghost overlayKeybindEsc"></button>
            <button id="overlayAcknowledge" class="dlg-btn dlg-primary overlayKeybindEnter"></button>
        </div>
    </div>
    <script src="./assets/js/scripts/overlay.js"></script>
</div>
