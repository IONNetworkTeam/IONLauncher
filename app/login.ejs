<div id="loginContainer" class="ob-view" style="display: none;">
    <div id="loginCancelContainer" class="ob-back-wrap" style="display: none;">
        <button id="loginCancelButton" class="ob-back">
            <svg class="ob-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
            <span><%- lang('login.loginCancelText') %></span>
        </button>
    </div>
    <form id="loginForm" class="ob-body" autocomplete="off">
        <h1 class="ob-title"><%- lang('login.loginSubheader') %></h1>
        <label class="ob-field">
            <span class="ob-field-head">
                <span><%- lang('login.loginEmailPlaceholder') %></span>
                <span class="ob-error" id="loginEmailError"><%- lang('login.loginEmailError') %></span>
            </span>
            <input id="loginUsername" class="ob-input" type="text" spellcheck="false"/>
        </label>
        <label class="ob-field">
            <span class="ob-field-head">
                <span><%- lang('login.loginPasswordPlaceholder') %></span>
                <span class="ob-error" id="loginPasswordError"><%- lang('login.loginPasswordError') %></span>
            </span>
            <input id="loginPassword" class="ob-input" type="password"/>
        </label>
        <div class="ob-row">
            <label id="checkmarkContainer" class="ob-check">
                <input id="loginRememberOption" type="checkbox" checked>
                <span class="ob-check-box" aria-hidden="true"></span>
                <span><%- lang('login.loginRememberMeText') %></span>
            </label>
            <a class="ob-link" href="<%- lang('login.loginForgotPasswordLink') %>"><%- lang('login.loginForgotPasswordText') %></a>
        </div>
        <button id="loginButton" class="ob-primary ob-primary-wide" disabled>
            <span><%- lang('login.loginButtonText') %></span>
            <svg class="ob-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            <span class="circle-loader"><span class="checkmark draw"></span></span>
        </button>
    </form>
    <div class="ob-foot">
        <p><a class="ob-link" href="<%- lang('login.loginNeedAccountLink') %>"><%- lang('login.loginNeedAccountText') %></a></p>
        <p><%- lang('login.loginPasswordDisclaimer1') %> <%- lang('login.loginPasswordDisclaimer2', { appName: lang('app.title') }) %></p>
    </div>
    <script src="./assets/js/scripts/login.js"></script>
</div>
